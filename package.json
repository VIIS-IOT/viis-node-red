    "test:error-notification:coverage": "jest error-notification --coverage",
    "test:marine": "jest MarineIoT",
    "test:marine:unit": "jest --testPathPattern=MarineIoT --testPathIgnorePatterns=integration",
    "test:marine:integration": "jest --testPathPattern=MarineIoT/.*integration",
    "test:marine:watch": "jest MarineIoT --watch",
    "test:marine:coverage": "jest MarineIoT --coverage",
    "test:marine-telemetry": "jest viis-marine-telemetry",
