    {
        "id": "prepare-auth-header",
        "type": "function",
        "z": "example-flow",
        "name": "Add Auth Header",
        "func": "// Get token from query parameter or header\nconst token = msg.req.query.token || msg.req.headers.authorization;\n\nif (!token) {\n    msg.statusCode = 400;\n    msg.payload = {\n        error: \"Bad Request\",\n        message: \"Token required in query parameter or Authorization header\"\n    };\n    return msg;\n}\n\n// Set authorization header\nmsg.headers = {\n    \"Authorization\": token.startsWith('Bearer ') ? token : `Bearer ${token}`,\n    \"Content-Type\": \"application/json\"\n};\n\n// Clear payload for GET request\nmsg.payload = \"\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 350,
        "y": 300,
        "wires": [
            ["get-user-request"]
        ]
    },
